# PostgreSQL connection (e.g. Vercel Postgres / Neon).
# DATABASE_URL is the pooled connection used by the app at runtime.
# DATABASE_URL_UNPOOLED is the direct connection used for migrations / schema push.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Secret used to sign session JWTs. Change this in production (min 32 chars).
AUTH_SECRET=""

# Optional SMTP for emailing receipts. If left blank, a temporary Ethereal
# test inbox is used and a preview link is returned instead of real delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GenTech <no-reply@gentech.local>"
